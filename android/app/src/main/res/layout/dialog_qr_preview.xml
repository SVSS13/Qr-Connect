<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvQrTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:textColor="?attr/colorOnSurface"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvQrSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="14sp" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="20dp"
        app:cardElevation="4dp"
        app:strokeColor="@color/card_stroke"
        app:strokeWidth="1dp">

        <ImageView
            android:id="@+id/ivQrCode"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="16dp"
            android:contentDescription="QR Code Bitmap" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvQrUrl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_token_pill"
        android:fontFamily="monospace"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:textColor="@color/primary"
        android:textSize="12sp" />

    <!-- Host Mode Selector -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Target URL Host"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupHostMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:singleSelection="true"
        app:selectionRequired="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipDevLocalhost"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dev Localhost" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipProdRender"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Render Cloud" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipVanity"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="qrconnect.me" />
    </com.google.android.material.chip.ChipGroup>

    <!-- Share QR Code as Image Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnShareQrDialog"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="18dp"
        android:backgroundTint="@color/primary"
        android:text="Share QR Code Image"
        android:textColor="@color/white"
        app:cornerRadius="12dp"
        app:icon="@android:drawable/ic_menu_share"
        app:iconTint="@color/white" />

    <!-- Export QR to Gallery / Device Pictures Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnExportQrDialog"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:text="Export to Gallery (Pictures)"
        app:cornerRadius="12dp"
        app:icon="@android:drawable/ic_menu_save" />

</LinearLayout>
