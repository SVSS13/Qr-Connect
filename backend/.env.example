# QR Connect Backend
PROJECT_NAME=QR Connect
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/qrconnect
SECRET_KEY=change-me-in-production-use-a-real-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
JWT_REFRESH_EXPIRY_DAYS=30
SESSION_EXPIRY_MINUTES=5
RATE_LIMIT_PER_MINUTE=30
CORS_ORIGINS=*

# Firebase Cloud Messaging
FCM_CREDENTIALS_JSON=

# Google Maps
GOOGLE_MAPS_API_KEY=

# IP Geolocation
IPGEO_API_KEY=

# Storage
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
